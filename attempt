class spin():
    def __init__(self,x,y,h,w):
        self.rect = pygame.Rect(x, y, h, w)
        self.clicked = False
    
    def draw(self, surf, col):
        pygame.draw.rect(surf, col, self.rect)
        pos = pygame.mouse.get_pos()
        if self.rect.collidepoint(pos):
            if pygame.mouse.get_pressed()[0] and not self.clicked:
                self.clicked = True
                print("Spin button clicked at", pos)
            if not pygame.mouse.get_pressed()[0]:
                self.clicked = False


while running:
    # poll for events
    # pygame.QUIT event means the user clicked X to close your window
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # fill the screen with a color to wipe away anything from last frame
    screen.fill(white)

    # Create slots, handle slot logics and functions here
    slot1 = slot(100, 100, 100, 200)
    slot1.draw(screen, (219,165,255))  

    # Create spin button, handle spin button logics and functions here
    spin1 = spin(300,350, 200, 75)
    spin1.draw(screen, (255,223,0))
    # flip() the display to put your work on screen
    pygame.display.flip()
    
pygame.quit()